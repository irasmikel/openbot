# Copia este archivo como .env para pruebas en tu PC. En GitHub van como Secrets/Variables.

# --- Telegram (obligatorio)
TELEGRAM_BOT_TOKEN=123456789:AA...
TELEGRAM_CHAT_ID=123456789

# --- API-Football (opcional pero recomendado: cuotas Bwin pre-partido + respaldo)
APIFOOTBALL_KEY=

# --- LLM del Estratega: gemini | openai_compat | none
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Para GLM (Z.ai) u otro compatible con OpenAI:
# LLM_PROVIDER=openai_compat
# OPENAI_COMPAT_BASE_URL=https://api.z.ai/api/paas/v4
# OPENAI_COMPAT_MODEL=glm-4.5-flash
# OPENAI_COMPAT_API_KEY=

# 1 = no envía a Telegram, imprime por consola
DRY_RUN=0
